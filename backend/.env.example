# ─── Contoh file .env untuk backend ───
# Salin file ini menjadi .env lalu isi nilai aslinya.
# Di Render, variabel berikut diisi lewat Dashboard → Environment Variables.

# API key dari https://console.groq.com (WAJIB)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server
HOST=0.0.0.0
PORT=8000

# true hanya untuk development lokal (aktifkan uvicorn reload + lazy-load).
# Di Render harus "false".
DEBUG=false

# Jumlah worker uvicorn. Plan Free (512MB RAM) = 1.
WORKERS=1

# (Opsional — VPS) Lokasi ChromaDB jika dipindah ke disk data terpisah:
# CHROMA_PERSIST_DIR=/var/data/skripsi/chroma_db
